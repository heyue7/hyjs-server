# Copy to .env; keep real settings private. Loaded by your shell/process manager.
HYJS_MYSQL_HOST=127.0.0.1:3306
HYJS_MYSQL_USER=hyjs
HYJS_MYSQL_PASSWORD=
HYJS_MYSQL_DATABASE=hyjs
HYJS_GAME_BIND=127.0.0.1
HYJS_GAME_ADVERTISE_HOST=127.0.0.1
HYJS_GAME_HTTP_PORT=18088
HYJS_GAME_TCP_PORT=19098
HYJS_GAME_SERVER_ID=1
HYJS_GAME_TABLES=../analysis/tables
# Only enable the demo wallet together with test payments in dev/test.
HYJS_GAME_ENABLE_TEST_PAYMENTS=false
HYJS_GAME_ENABLE_LOCAL_WALLET=false
